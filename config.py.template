"""Configuration for the fairy tale playlist picker.

Copy this file to config.py and fill in the values:
    cp config.py.template config.py
"""

import os

# --- Spotify credentials ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID = ""
SPOTIFY_CLIENT_SECRET = ""
SPOTIFY_REDIRECT_URI = "http://127.0.0.1:8888/callback"

# --- Playlist source (GitHub Gist) ---
# Raw URL of a GitHub Gist containing one Spotify URI per line.
GIST_RAW_URL = ""
GIST_REFRESH_S = 3600

# --- Spotify device ---
# Device ID of the target speaker. Run tests/test_spotify.py to find it.
SPOTIFY_DEVICE_ID = ""

# --- Chromecast device (for mp3 playback) ---
# Friendly name of the Chromecast-built-in speaker (e.g. "Bose Smart Speaker 500").
# Run tests/test_chromecast.py to discover available devices.
CHROMECAST_NAME = ""

# Optional fallback if mDNS discovery doesn't reach the speaker (e.g. router
# blocks multicast across 2.4/5 GHz bands). Set to the speaker's LAN IP and
# reserve it in your router's DHCP table so it doesn't change.
CHROMECAST_HOST = ""

# --- GPIO pins (Breakout Garden header) ---
PIN_CLK = 2   # Encoder CLK → SDA
PIN_DT = 3    # Encoder DT  → SCL
PIN_SW = 4    # Encoder SW  → INT

# --- Paths ---
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
CACHE_DIR = os.path.join(BASE_DIR, "cache")
SPOTIFY_CACHE_PATH = os.path.join(BASE_DIR, ".spotify_cache")

# --- Display ---
IDLE_TIMEOUT_S = 60
