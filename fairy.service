[Unit]
Description=Fairy Tale Playlist Picker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fairy
WorkingDirectory=/home/fairy/fairy
ExecStart=/home/fairy/fairy-env/bin/python main.py
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
